(defun is-at-last-col ()
        (interactive)
        (save-excursion
                (end-of-line)
                (setq last-col (current-column))
                )
        (setq was-at-last-col 0)
        (if (eq last-col (current-column))
                        (setq was-at-last-col 1)
                )
        )

